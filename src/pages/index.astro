---
import { getCollection } from 'astro:content';
import { isDiscoverable, isSecurity } from '../lib/content-mode';
import BaseLayout from '../layouts/BaseLayout.astro';
import MissionCard from '../components/MissionCard.astro';
import OrbitMap from '../components/OrbitMap.astro';
import { professional } from '../data/site-content';
import { home } from '../data/site-content';
import { missions } from '../data/site-content';
import { now } from '../data/site-content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => isDiscoverable(data) && (isSecurity || data.featured)))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));

---

<BaseLayout
  title={home.title}
  description={home.description}
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="kicker ops-only">{home.kickerOps}</p>
      <p class="kicker direct-only">{home.kickerDirect}</p>
      <h1>{home.headline} <span>{home.headlineEmphasis}</span>.</h1>
      <p class="mission-copy">{home.missionCopy}</p>
      <div class="hero-actions">
        <a class="primary-action" href="#selected-work">
          <span class="ops-only">{home.primaryActionOps}</span>
          <span class="direct-only">{home.primaryActionDirect}</span>
        </a>
        <a href={`${base}/blog`}>
          <span class="ops-only">{home.secondaryActionOps}</span>
          <span class="direct-only">{home.secondaryActionDirect}</span>
        </a>
      </div>
    </div>
    <OrbitMap />
  </section>

  <section class="now-panel" aria-labelledby="professional-heading">
    <h2 id="professional-heading">{professional.heading}</h2>
    <p>{professional.summary}</p>
    <p>{professional.direction}</p>
    <nav class="hero-actions" aria-label="Professional resources">
      <a href={`${base}/resume`}>View resume</a>
      <a href="https://www.linkedin.com/in/shawnmcampbell">LinkedIn</a>
      <a href="https://github.com/jaegerpicker">GitHub</a>
      <a href="mailto:shawn@sandkcampbell.com">Email Shawn</a>
    </nav>
  </section>

  <section class="now-panel" aria-labelledby="now-heading">
    <div class="now-head">
      <p class="kicker ops-only">Current Position</p>
      <p class="kicker direct-only">Current Focus</p>
      <h2 id="now-heading">Now</h2>
      <p class="now-updated">Updated {now.updated}</p>
    </div>
    <ul class="now-list">
      {now.lines.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="mission-board" id="selected-work" aria-labelledby="work-heading">
    <header>
      <p class="kicker ops-only">Active Mission Board</p>
      <p class="kicker direct-only">Selected Work</p>
      <h2 id="work-heading">
        <span class="ops-only">{home.workHeadingOps}</span>
        <span class="direct-only">{home.workHeadingDirect}</span>
      </h2>
      <p>{home.workIntro}</p>
    </header>
    <div class="mission-grid">
      {missions.map((mission) => <MissionCard {...mission} />)}
    </div>
  </section>

  <section class="current-course" id={home.courseId} aria-labelledby="course-heading">
    <div>
      <p class="kicker ops-only">Current Trajectory</p>
      <p class="kicker direct-only">Current Focus</p>
      <h2 id="course-heading">{home.courseHeading}</h2>
    </div>
    <p>{home.courseBody}</p>
  </section>

  <section class="systems-rigor" id="systems-rigor">
    <p class="kicker ops-only">Hull Integrity</p>
    <p class="kicker direct-only">{home.rigorKickerDirect}</p>
    <h2>{home.rigorHeading}</h2>
    <p>{home.rigorBody}</p>
  </section>

  {posts.length > 0 && (
    <section class="latest-section" aria-labelledby="latest-heading">
      <p class="kicker ops-only">Latest Transmissions</p>
      <p class="kicker direct-only">Latest Writing</p>
      <h2 id="latest-heading">{home.latestHeading}</h2>
      <div class="post-grid">
        {posts.map((post) => (
          <a class="signal-card" href={`${base}/blog/${post.id}`}>
            <span class="signal-card__label">{post.data.draft ? 'Draft / local review' : 'Project note'}</span>
            <span class="signal-card__title">{post.data.title}</span>
            <p class="muted">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .now-panel {
    border: 1px solid var(--border);
    background: var(--bg-panel);
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1.25rem 1.4rem;
  }

  .now-head h2 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0;
  }

  .now-updated {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin: 0.3rem 0 0;
  }

  .now-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .now-list li {
    color: var(--fg-muted);
    line-height: 1.5;
  }

  @media (min-width: 52rem) {
    .now-panel {
      grid-template-columns: minmax(10rem, 14rem) 1fr;
      gap: 1.5rem;
    }
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    min-height: min(39rem, calc(100vh - 8rem));
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(rgba(94, 218, 231, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(94, 218, 231, 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .hero-copy {
    min-width: 0;
    align-self: center;
    padding: clamp(2.5rem, 7vw, 5rem) clamp(1.25rem, 5vw, 4.5rem);
  }

  .home-hero h1 {
    margin: 0;
    max-width: 52rem;
    font-size: clamp(3.2rem, 6vw, 5.65rem);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .home-hero h1 span {
    color: var(--warning-strong);
  }

  .mission-copy {
    max-width: 44rem;
    color: var(--fg-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-actions a {
    border: 1px solid var(--border-strong);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.7rem 0.85rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero-actions .primary-action {
    border-color: var(--warning);
    background: var(--warning);
    color: var(--control-active-fg);
  }

  .mission-board {
    display: grid;
    grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 2.2fr);
    border-bottom: 1px solid var(--border);
  }

  .mission-board > header {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-right: 1px solid var(--border);
  }

  .mission-board h2,
  .current-course h2,
  .systems-rigor h2 {
    margin-top: 0;
  }

  .mission-board header > p:last-child,
  .current-course > p,
  .systems-rigor > p:last-child {
    color: var(--fg-muted);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .current-course,
  .systems-rigor {
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .current-course {
    background: rgba(169, 212, 110, 0.045);
  }

  .systems-rigor {
    background: rgba(238, 119, 99, 0.04);
  }

  .latest-section {
    padding-top: 2rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  @media (max-width: 760px) {
    .home-hero,
    .mission-board,
    .current-course,
    .systems-rigor {
      grid-template-columns: 1fr;
    }

    .home-hero {
      min-height: auto;
    }

    .hero-copy {
      padding: 2.75rem 1.25rem 1.5rem;
    }

    .home-hero h1 {
      font-size: clamp(2rem, 11vw, 3.6rem);
      overflow-wrap: anywhere;
    }

    .mission-board > header {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .mission-grid {
      grid-template-columns: 1fr;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-view='direct']) .home-hero {
    min-height: auto;
    background: transparent;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
  }

  :global(html[data-view='direct']) .home-hero h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    text-transform: none;
  }

  :global(html[data-view='direct']) .mission-board {
    grid-template-columns: 1fr;
  }

  :global(html[data-view='direct']) .mission-board > header {
    border-right: 0;
  }

  :global(html[data-view='direct']) .mission-grid {
    gap: 0.75rem;
    padding: 0 2rem 2rem;
  }

  @media (max-width: 760px) {
    :global(html[data-view='direct']) .home-hero {
      grid-template-columns: 1fr;
    }

    :global(html[data-view='direct']) .mission-grid {
      padding: 0 1rem 1rem;
    }
  }
</style>
