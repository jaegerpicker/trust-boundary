---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/site-content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

---

<BaseLayout title="About — Trust Boundary" description={about.lead}>
  <section class="about-panel">
    <p class="kicker ops-only">Origin Signal / Profile</p>
    <p class="kicker direct-only">About</p>
    <h1>Trust Boundary</h1>
    <p class="lead">{about.lead}</p>
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <aside>
      <p class="kicker ops-only">Current Course</p>
      <p class="kicker direct-only">Current Direction</p>
      <p>{about.direction}</p>
    </aside>
    <nav class="about-links" aria-label="Profile links">
      <a href="mailto:shawn@sandkcampbell.com">Email Shawn</a>
      <a href="https://www.linkedin.com/in/shawnmcampbell">LinkedIn</a>
      <a href="https://github.com/jaegerpicker">GitHub</a>
      <a href={`${base}/projects`}>Projects</a>
      <a href={`${base}/blog`}>Blog</a>
      <a href={`${base}/resume`}>Resume</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .about-panel {
    padding: clamp(2rem, 7vw, 5rem);
    border-bottom: 1px solid var(--border);
  }

  .about-panel h1 {
    margin: 0 0 0.75rem;
  }

  .about-panel p {
    max-width: 52rem;
    color: var(--fg-muted);
  }

  .about-panel .lead {
    color: var(--fg);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
  }

  aside {
    max-width: 52rem;
    margin-top: 2rem;
    border-left: 3px solid var(--warning);
    background: rgba(228, 173, 84, 0.05);
    padding: 1rem 1.25rem;
  }

  aside p:last-child {
    margin-bottom: 0;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .about-links a {
    border: 1px solid var(--border);
    color: var(--link);
    font-family: var(--font-mono);
    padding: 0.5rem 0.75rem;
    text-transform: uppercase;
  }

  .about-links a:hover,
  .about-links a:focus-visible {
    border-color: var(--border-strong);
    color: var(--warning-strong);
    text-decoration: none;
  }
</style>
