---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { meta } from '../data/site-content';

interface Props {
  title: string;
  description?: string;
  defaultView?: 'ops' | 'direct';
  noindex?: boolean;
}

const {
  title,
  description = meta.description,
  defaultView = 'ops',
  noindex = false,
} = Astro.props;
const shareImage = new URL('images/trust-boundary-share.png', Astro.site).toString();
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('#shawn-campbell', Astro.site).toString(),
  name: 'Shawn Campbell',
  url: Astro.site?.toString(),
  sameAs: ['https://www.linkedin.com/in/shawnmcampbell', 'https://github.com/jaegerpicker'],
};
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-view={defaultView}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const storageKey = 'site-view';
        const queryMode = new URLSearchParams(window.location.search).get('view');
        const isMode = (value) => value === 'ops' || value === 'direct';
        let storedMode = null;

        try {
          storedMode = localStorage.getItem(storageKey);
        } catch {
          // Storage can be unavailable in privacy-focused browser contexts.
        }

        // The server rendered the page's own default into the attribute.
        const pageDefault = document.documentElement.dataset.view;
        const mode = isMode(queryMode)
          ? queryMode
          : isMode(storedMode)
            ? storedMode
            : isMode(pageDefault)
              ? pageDefault
              : 'ops';

        document.documentElement.dataset.view = mode;

        if (isMode(queryMode)) {
          try {
            localStorage.setItem(storageKey, mode);
          } catch {
            // The selected mode still applies for the current page.
          }
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trust Boundary" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Trust Boundary by Shawn Campbell — mobile, web, and interactive products. Amber crosshair on a dark background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="Trust Boundary by Shawn Campbell — mobile, web, and interactive products." />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Trust Boundary"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
